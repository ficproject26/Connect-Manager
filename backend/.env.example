# Production Environment Template
PORT=8005
NODE_ENV=production
# In production, specify a high-entropy secret (min 32 random characters)
JWT_SECRET=replace_with_strong_production_secret_key_32chars_min

# Database & Cache Configurations (TLS enabled)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<redis-host>:<redis-port>

# Allowed CORS Origins (comma-separated if multiple)
ALLOWED_ORIGINS=https://manager.ficapp.in,https://connect-manager.vercel.app
